{
  "name": "@artmizu/nuxt-prometheus",
  "type": "module",
  "version": "4.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": "Allows you to better understand what's going on with your application and how to optimize performance and other things in production",
  "license": "MIT",
  "repository": "artmizu/nuxt-prometheus",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground --inspect --host",
    "start": "node ./playground/.output/server/index.mjs",
    "start:debug": "cross-env NODE_OPTIONS='--max-http-header-size=65384' NITRO_PORT=3000 node --inspect ./playground/.output/server/index.mjs",
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build && nuxi prepare playground",
    "build:prepare": "nuxt-module-build prepare && nuxt-module-build build && nuxi build playground",
    "test": "pnpm prepack && pnpm exec playwright install chromium --only-shell && vitest --dir ./test --no-file-parallelism",
    "test:memory": "nuxt-module-build prepare && pnpm prepack && nuxi build test/fixtures/interceptor && node scripts/memory/run.mjs",
    "test:type": "vitest --typecheck.only --typecheck.ignoreSourceErrors --dir ./test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "k6": "k6 run ./k6/load.test.js"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.45.10",
    "@prometheus-io/client": "^0.16.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "h3": "^2.0.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/kit": "^4.6.3",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "nuxt": "^4.6.3",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
